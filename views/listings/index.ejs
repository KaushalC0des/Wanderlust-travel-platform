<% layout('layout/boilerplate') %>
<!-- <%- include("../includes/flash") %> -->
<!-- <h3>All Listings</h3> -->

<style>
  #filters {
  display: flex;
  flex-wrap: nowrap;             /* Prevent wrapping */
  overflow-x: auto;              /* Horizontal scroll */
  scrollbar-width: none;         /* Hide scrollbar (Firefox) */
  -ms-overflow-style: none;      /* Hide scrollbar (IE/Edge) */
  padding: 1rem 0;
  gap: 2rem;                     /* Space between icons */
}

#filters::-webkit-scrollbar {
  display: none;                 /* Hide scrollbar (Chrome, Safari) */
}

.filter {
  flex: 0 0 auto;                /* Prevent shrinking */
  text-align: center;
  opacity: 0.7;
  transition: opacity 0.2s;
}

.filter:hover {
  opacity: 1;
  cursor: pointer;
}

.filter i {
  font-size: 1.5rem;
  margin-bottom: 0.3rem;
}

.filter p {
  font-size: 0.8rem;
  margin: 0;
}

.tax-toggle {
  flex: 0 0 auto;
  margin-left: auto;
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.tax-info {
  display: none;
}

/* ================= AI CHAT ================= */

#ai-button {
  position: fixed;
  right: 30px;
  bottom: 30px;

  width: 60px;
  height: 60px;

  border: none;
  border-radius: 50%;

  background: #ff385c;
  color: white;

  font-size: 28px;

  cursor: pointer;

  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);

  z-index: 1000;
}

#ai-button:hover {
  transform: scale(1.05);
}


/* Chat Window */

#ai-chat-box {
  position: fixed;

  right: 30px;
  bottom: 100px;

  width: 360px;
  height: 500px;

  background: white;

  border-radius: 15px;

  box-shadow: 0 5px 25px rgba(0, 0, 0, 0.25);

  display: none;

  flex-direction: column;

  overflow: hidden;

  z-index: 1000;
}


/* Header */

#ai-chat-header {
  background: #ff385c;
  color: white;

  padding: 15px;

  display: flex;
  justify-content: space-between;
  align-items: center;

  font-weight: bold;
}

#ai-close {
  background: none;
  border: none;

  color: white;

  font-size: 25px;

  cursor: pointer;
}


/* Messages */

#ai-messages {
  flex: 1;

  padding: 15px;

  overflow-y: auto;

  display: flex;
  flex-direction: column;

  gap: 10px;
}

.ai-message {
  background: #f1f1f1;

  padding: 10px 12px;

  border-radius: 10px;

  max-width: 85%;

  font-size: 14px;
}

.user-message {
  background: #ff385c;
  color: white;

  padding: 10px 12px;

  border-radius: 10px;

  max-width: 85%;

  align-self: flex-end;

  font-size: 14px;
}


/* Input */

#ai-input-area {
  display: flex;

  padding: 10px;

  border-top: 1px solid #ddd;

  gap: 8px;
}

#ai-input {
  flex: 1;

  border: 1px solid #ddd;

  border-radius: 20px;

  padding: 10px 15px;

  outline: none;
}

#ai-send {
  border: none;

  background: #ff385c;
  color: white;

  border-radius: 20px;

  padding: 8px 15px;

  cursor: pointer;
}

</style>

<div id="filters">

  <a href="/listings/category/Trending" class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </a>

  <a href="/listings/category/Rooms" class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </a>

  <a href="/listings/category/Adventure" class="filter">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Adventure</p>
  </a>

  <a href="/listings/category/Nature" class="filter">
    <div><i class="fa-solid fa-tree"></i></div>
    <p>Nature</p>
  </a>

  <a href="/listings/category/Castles" class="filter">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </a>

  <a href="/listings/category/Amazing Pools" class="filter">
    <div><i class="fa-brands fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </a>

  <a href="/listings/category/Camping" class="filter">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </a>

  <a href="/listings/category/Farms" class="filter">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </a>

  <a href="/listings/category/Arctic" class="filter">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </a>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>

</div>




<div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3">
  <% for (let listing of listings) { %>
    <div class="col">
      <a href="/listings/<%=listing._id%>" class="listing-link">
        <div class="card mb-4" style="width: 100%;">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <h5 class="card-title"><%= listing.title %></h5>
            <h6 class="card-subtitle mb-2 text-muted">
            <% if (listing.price) { %>
               &#8377;<%= listing.price%> / night
              <% } else { %>
                Price not available
              <% } %>
            </h6>
            <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
            <p class="card-text"><%= listing.description %></p>
            <a href="/listings/<%= listing._id %>" class="btn btn-primary">View Details</a>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>


<!-- WanderLust AI -->

<!-- AI Assistant Button -->
<button id="ai-button" title="WanderLust AI">
  🤖
</button>

<!-- AI Chat Window -->
<div id="ai-chat-box">

  <div id="ai-chat-header">
    <span>🤖 WanderLust AI</span>
    <button id="ai-close">×</button>
  </div>

  <div id="ai-messages">
    <div class="ai-message">
      Hi! 👋 I'm WanderLust AI.<br>
      Ask me about hotels, prices, locations, categories, etc.
    </div>
  </div>

  <div id="ai-input-area">
    <input
      type="text"
      id="ai-input"
      placeholder="Ask about hotels..."
      autocomplete="off"
    />

    <button id="ai-send">
      Send
    </button>
  </div>

</div>

<script src="/js/ai.js"></script>


<script>
  
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo) {
      if(info.style.display != "inline"){
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }  
  });

</script> 




