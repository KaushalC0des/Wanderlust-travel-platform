<style>
  /* Airbnb Style Search */
  .airbnb-search-box {
    border: 1px solid #ddd;
    padding: 10px 20px;
    border-radius: 40px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    background: white;
    transition: 0.2s ease;
  }

  .airbnb-search-box:hover {
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
  }

  .airbnb-input {
    border: none;
    outline: none;
    font-size: 1rem;
    width: 100%;
  }

  .airbnb-search-btn {
    background-color: #ff385c;
    border-radius: 50%;
    padding: 10px 12px;
    color: white;
    border: none;
  }

  /* MAKE SEARCH BAR WIDE & CENTERED */
  .search-wide {
    width: 550px;
    max-width: 650px;
  }

  @media (min-width: 1400px) {
    .search-wide {
      width: 650px;
    }
  }

  @media (max-width: 992px) {
    .search-wide {
      width: 420px;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-white sticky-top navbar-shadow py-2">
  <div class="container-fluid d-flex align-items-center">

    <!-- LEFT LOGO -->
    <a class="navbar-brand fw-bold text-danger me-3" href="/listings" style="font-size: 1.4rem;">
      <i class="fa-solid fa-house-chimney"></i> WanderLust
    </a>

    <!-- CENTER SEARCH BAR -->
    <div class="d-none d-md-flex flex-grow-1 justify-content-center">
      <form action="/search" method="GET" class="d-flex align-items-center airbnb-search-box search-wide">
        <input class="airbnb-input" type="search" name="q" placeholder="Search Destinations">
        <button class="airbnb-search-btn ms-2" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
    </div>

    <!-- RIGHT SIDE -->
    <div class="ms-auto d-flex align-items-center">
      <button class="navbar-toggler ms-3" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>

    <!-- COLLAPSE MENU -->
    <div class="collapse navbar-collapse" id="mainMenu">

      <!-- MOBILE SEARCH BAR -->
      <form action="/search" method="GET" class="d-flex d-md-none airbnb-search-box my-3 mx-2 w-100">
        <input class="airbnb-input" type="search" name="q" placeholder="Search Destinations">
        <button class="airbnb-search-btn ms-2" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>

      <!-- RIGHT NAV LINKS -->
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Add new Listing</a>

        <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
        <% } else { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>

      </div>
    </div>

  </div>
</nav>




