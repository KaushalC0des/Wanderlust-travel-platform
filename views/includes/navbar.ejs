<style>
.navbar{
    background:#fff;
    border-bottom:1px solid #ececec;
    box-shadow:0 2px 12px rgba(0,0,0,.05);
    padding:.75rem 0;
}

.navbar-brand{
    font-size:1.6rem;
    font-weight:700;
    color:#ff385c !important;
}

.navbar-brand i{
    margin-right:6px;
}

.airbnb-search-box{
    display:flex;
    align-items:center;
    width:100%;
    max-width:500px;
    border:1px solid #ddd;
    border-radius:40px;
    padding:8px 10px 8px 20px;
    background:#fff;
    transition:.25s;
}

.airbnb-search-box:hover{
    box-shadow:0 4px 16px rgba(0,0,0,.12);
}

.airbnb-input{
    flex:1;
    border:none;
    outline:none;
    background:none;
    font-size:.95rem;
}

.airbnb-search-btn{
    border:none;
    background:#ff385c;
    color:white;
    width:42px;
    height:42px;
    border-radius:50%;
    transition:.2s;
}

.airbnb-search-btn:hover{
    transform:scale(1.05);
}

.navbar-nav .nav-link{
    font-weight:500;
    color:#333 !important;
    margin-left:10px;
}

.navbar-nav .nav-link:hover{
    color:#ff385c !important;
}

.add-btn{
    border:1px solid #ff385c;
    color:#ff385c !important;
    border-radius:30px;
    padding:7px 18px !important;
    transition:.2s;
}

.add-btn:hover{
    background:#ff385c;
    color:white !important;
}

@media(max-width:768px){

.airbnb-search-box{
    max-width:100%;
    margin-top:15px;
}

.navbar-collapse{
    padding-top:15px;
}

.navbar-nav .nav-link{
    margin-left:0;
    padding:12px 5px;
}
}
</style> 

<nav class="navbar navbar-expand-lg sticky-top">

  <div class="container">

  <a class="navbar-brand" href="/listings">
  <i class="fa-solid fa-house-chimney"></i>
  WanderLust
  </a>

  <button class="navbar-toggler"
  type="button"
  data-bs-toggle="collapse"
  data-bs-target="#mainMenu">
  <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse" id="mainMenu">

  <div class="mx-auto my-3 my-lg-0">

  <form action="/search" method="GET" class="airbnb-search-box">

  <input
  type="search"
  name="q"
  class="airbnb-input"
  placeholder="Search destinations">

  <button class="airbnb-search-btn">
  <i class="fa-solid fa-magnifying-glass"></i>
  </button>

  </form>

  </div>

  <ul class="navbar-nav ms-auto align-items-lg-center">

  <li class="nav-item">
  <a class="nav-link add-btn" href="/listings/new">
  Add Listing
  </a>
  </li>

  <% if(!currUser){ %>

  <li class="nav-item">
  <a class="nav-link" href="/signup">
  Sign Up
  </a>
  </li>

  <li class="nav-item">
  <a class="nav-link" href="/login">
  Login
  </a>
  </li>

  <% }else{ %>

  <li class="nav-item">
  <a class="nav-link" href="/logout">
  Logout
  </a>
  </li>

  <% } %>

  </ul>

  </div>

  </div>

</nav>



